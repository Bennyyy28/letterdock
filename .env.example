# Run npm run setup to create .env.local with unique authentication credentials.
LETTERDOCK_ORIGIN=http://localhost:3000
LETTERDOCK_PASSWORD_HASH=
LETTERDOCK_SESSION_SECRET=
LETTERDOCK_OWNER_NAME=My inbox

# Server-only Resend key. Never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Replace the synthetic UUID with your inbox ID from the Resend dashboard.
# Add up to 10 entries with unique keys and IDs. Keep this JSON on one line.
RESEND_INBOXES='[{"key":"personal","id":"00000000-0000-4000-8000-000000000001","name":"Personal","address":"you@example.com","description":"Personal mail"}]'

# Sending is OFF by default. Set to one configured key to enable manual compose/reply.
# Leave empty for an inbox used by an agent. No autonomous sending is exposed.
LETTERDOCK_SENDING_INBOX=
