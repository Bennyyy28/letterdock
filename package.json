{
  "name": "letterdock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A self-hosted inbox for Resend Inboxes.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/env-setup.mjs --import tsx --test tests/*.test.ts",
    "check:public": "node scripts/check-public-source.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "jose": "6.2.15",
    "lucide-react": "^1.66.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "class-variance-authority": "^0.7.1",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "tailwindcss": "^4.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "tsx": "^4.21.0"
  }
}
